# Cloudflare Pages / Netlify-style caching headers.
# Vercel / nginx equivalents live in vercel.json / nginx.conf.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Hashed JS / CSS — immutable, cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images & videos in /assets/img and /assets/video — also hashed.
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable
/assets/video/*
  Cache-Control: public, max-age=31536000, immutable

# Public, non-hashed assets in /assets/images and /assets/videos —
# served by name, so cache for a week with revalidation.
/assets/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/assets/videos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/assets/mayave/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/assets/web/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Fonts (if self-hosted).
/assets/font/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# HTML — never cache (SPA index must always be fresh).
/
  Cache-Control: public, max-age=0, must-revalidate
/*
  Cache-Control: public, max-age=0, must-revalidate

# Sitemap & robots — short cache.
/sitemap.xml
  Cache-Control: public, max-age=86400
/robots.txt
  Cache-Control: public, max-age=86400
